# Database (PostgreSQL / Neon / Supabase / Vercel Postgres)
# If left unset, the app uses embedded PGLite in-memory database automatically.
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Better Auth Secret (recommended for production)
# BETTER_AUTH_SECRET="your-32-character-random-secret"

# Public URL of the deployed application
# BETTER_AUTH_URL="https://your-app.vercel.app"

# Optional Auth Provider Credentials (if using Grok/OAuth federation)
# GROK_AUTH_CLIENT_ID=""
# GROK_AUTH_CLIENT_SECRET=""
